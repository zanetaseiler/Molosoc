{
  "canvas": {
    "aspect": [4, 5],
    "aspectTolerance": 0.02
  },
  "fonts": {
    "serif": {
      "family": "DM Serif Display",
      "files": ["fonts/DMSerifDisplay-Regular.ttf"]
    },
    "sans": {
      "family": "Mulish",
      "files": [
        "fonts/Mulish-Regular.ttf",
        "fonts/Mulish-Medium.ttf",
        "fonts/Mulish-SemiBold.ttf"
      ]
    }
  },
  "colors": {
    "ink": "#0C1115",
    "inkWarm": "#241D17",
    "cream": "#F8F7F4"
  },
  "defaults": {
    "headline": {
      "fontFamily": "DM Serif Display",
      "fontWeight": 400,
      "fontSizeFrac": 0.075,
      "lineHeightFactor": 1.05,
      "color": "ink",
      "letterSpacing": 0
    },
    "supporting": {
      "fontFamily": "Mulish",
      "fontWeight": 600,
      "fontSizeFrac": 0.028,
      "lineHeightFactor": 1.3,
      "color": "ink",
      "letterSpacing": 0.015,
      "gapFactor": 0.32
    }
  }
}
