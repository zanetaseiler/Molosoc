# Never commit secrets
.env
*.env
secrets/

# OS/editor noise
.DS_Store
.vscode/
.idea/

# Local Claude Code session config (machine-specific, not shared)
.claude/settings.local.json

# Python
__pycache__/
*.pyc
.pytest_cache/

# Local analytics store. Git is deliberately NOT the analytics database —
# snapshots belong in durable external storage, not in this repo's history.
analytics-data/

# Node (if theme build tooling gets added later)
node_modules/

# Generated weekly reports are build artifacts, never commits.
reports/

# Generated dashboard page — a build output, uploaded to the report host.
site/index.html
